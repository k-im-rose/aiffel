<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.investment-briefing.daily</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>__PROJECT_DIR__/deploy/run_daily.sh</string></array>
  <!-- 맥의 시간대 기준. 맥이 한국 시간(Asia/Seoul)으로 설정돼 있어야 07:35 KST다 -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>35</integer></dict>
  <key>StandardOutPath</key><string>__PROJECT_DIR__/outputs/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>__PROJECT_DIR__/outputs/logs/launchd.err</string>
</dict>
</plist>
